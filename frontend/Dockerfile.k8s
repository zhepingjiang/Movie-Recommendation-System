# Production build for the minikube deployment path. Unlike the dev-mode frontend/Dockerfile
# (Vite dev server, used by docker-compose for hot-reload -- see vite.config.ts's usePolling
# comment for why that one needs a bind mount at all), this compiles a static bundle and serves
# it via nginx. VITE_API_BASE_URL is left at its build-time default (http://localhost:8080)
# because the k8s backend Service is reached via `kubectl port-forward` to that same host port --
# see the k8s migration summary for why nothing needs to change here.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
